dataset:
  data_path: data/liverdiagnostic.csv
  input_features: 11
  name: liverdiagnostic
  num_classes: 2
  target_column: Selector
export:
  edge_impulse:
    enabled: true
    project_id: 669207
  enabled: true
  onnx_dir: models/liverdiagnostic/relu/onnx
inference:
  batch_size: 32
  enabled: true
  output_dir: results/liverdiagnostic/relu/inference
model:
  activation: tanh
  base_dir: models/liverdiagnostic/relu
  hidden_neurons: 16
output:
  results_dir: results/liverdiagnostic/relu
  save_dir: models/liverdiagnostic/tanh/pruned
pruning:
  accuracy_drop: 0.05
  activity_threshold: 0.1
  correlation_threshold: 0.8
  enabled: true
  pruned: false
  save_dir: models/liverdiagnostic/tanh/pruned
  sensitivity_threshold: 0.01
  validation:
    accuracy_weight: 1.0
    batch_size: 3
    max_accuracy_drop: 0.05
    max_neurons_pruned: 8
    min_accuracy: 0.85
    require_min_neurons: 6
    size_weight: 0.0
    target_pruning_rate: 0.6
    validation_strategy: batch
training:
  batch_size: 32
  enabled: true
  epochs: 1000
  learning_rate: 0.001
  save_dir: models/liverdiagnostic/tanh/original
